# Environment: Development
# Description: Environment variables for development environment
# Note: Only VITE_ prefixed variables are exposed to the frontend.

# PrimeUI
VITE_PRIME_UI_LICENSE_KEY="<community-license-key>"

# Alerting & Incident Management (incidents, delays, notifications)
VITE_INCIDENTS_API_BASE_URL="https://6a4ec144e785c9ef536d1e99.mockapi.io/api/v1"
VITE_INCIDENTS_ENDPOINT_PATH="/incidents"
VITE_DELAYS_ENDPOINT_PATH="/delays"
VITE_NOTIFICATIONS_ENDPOINT_PATH="/notifications"
VITE_NOTIFICATION_SETTINGS_ENDPOINT_PATH="/notificationSettings"

# Vehicle & Credential Management
VITE_VEHICLES_API_URL="https://6ac59b2c54a61668c5f745e7.mockapi.io/api/v1"
VITE_VEHICLES_ENDPOINT_PATH="/vehicles"

# Route & Trip Planning
VITE_ROUTE_API_BASE_URL="https://6ac5a99754a61668c5f74d74.mockapi.io/api/v1"
VITE_ROUTE_ROUTES_ENDPOINT_PATH="/routes"

# Subscriptions & Billing
VITE_BILLING_API_BASE_URL="https://6ac54a6d54a61668c5f7141c.mockapi.io/api/v1"
VITE_BILLING_PLANS_ENDPOINT_PATH="/plans"
VITE_BILLING_SUBSCRIPTIONS_ENDPOINT_PATH="/subscriptions"

# Profiles & Relationship Management - Profiles
VITE_PROFILES_API_BASE_URL="https://6ac53c3d54a61668c5f700f2.mockapi.io/api/v1"
VITE_PROFILES_STUDENTS_ENDPOINT_PATH="/students"
VITE_PROFILES_PROFILES_ENDPOINT_PATH="/profiles"

# Profiles & Relationship Management - Relationships
VITE_RELATIONSHIPS_API_BASE_URL="https://6ac54f4854a61668c5f718ab.mockapi.io/api/v1"
VITE_RELATIONSHIPS_TUTOR_STUDENTS_ENDPOINT_PATH="/tutor-student-relationships"
VITE_RELATIONSHIPS_DATA_DELETION_REQUESTS_ENDPOINT_PATH="/data-deletion-requests"